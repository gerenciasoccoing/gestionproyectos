# Variables usadas por docker-compose.yml al desplegar (backend + frontend + Postgres
# en un solo servidor). Copiar a ".env" en el servidor y completar con valores reales
# (nunca commitear el ".env" real).

POSTGRES_PASSWORD=cambia-esta-clave-de-base-de-datos
JWT_SECRET=cambia-este-secreto-jwt-por-uno-largo-y-aleatorio
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=cambia-esta-clave-de-admin
