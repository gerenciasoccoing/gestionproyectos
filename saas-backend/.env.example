PORT=4100
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas_ecommerce
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
CORS_ORIGIN=*

# Dominio base de la plataforma para resolver tenants por subdominio: <subdominio>.BASE_DOMAIN
BASE_DOMAIN=tuapp.com

# Clave de 32 bytes (64 caracteres hex) usada para cifrar credenciales sensibles de cada tenant
# (llaves de Wompi, credenciales del Proveedor Tecnologico de facturacion) antes de guardarlas.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Credenciales del super-admin creadas por el script de seed
SUPERADMIN_EMAIL=superadmin@tuapp.com
SUPERADMIN_PASSWORD=changeme123
