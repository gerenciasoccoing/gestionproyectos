PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gestionproyectos
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=8h
UPLOAD_DIR=uploads
CORS_ORIGIN=http://localhost:5173
# Integración WhatsApp (módulo Inventario) — cuenta de LoroAPI
LOROAPI_BASE_URL=https://loroapi.com/api/v1
LOROAPI_API_KEY=
# Confirmación de recepción/devolución por enlace público (Inventario)
FRONTEND_PUBLIC_URL=http://localhost:5173
INVENTORY_CONFIRMATION_HOURS=48
# Lectura automática de documentos con IA (RUT, facturas, contratos, pólizas) — API de Claude
# (Anthropic). Nunca se expone al frontend: solo se usa en el backend. Si se deja vacía, RUT y
# facturas siguen funcionando con el motor local (OCR); contratos y pólizas requieren esta clave.
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5-20250929
# Cuenta inicial de operador de la plataforma (panel de super-admin) — solo se usan una vez, al
# correr `node src/scripts/createPlatformAdmin.js` a mano; no hace falta dejarlas puestas después.
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
