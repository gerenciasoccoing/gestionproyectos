PORT=4000
# Conexión restringida (Capa 2 del aislamiento multi-tenant, Row-Level Security): la que usa la
# app en tiempo real. El rol de este usuario NO es dueño de las tablas — se crea solo, en el
# primer arranque, con la contraseña de APP_DB_PASSWORD (ver postSyncFixups.js#ensureAppDbRole).
DATABASE_URL=postgres://gestionproyectos_app:change-this-app-db-password@localhost:5432/gestionproyectos
APP_DB_PASSWORD=change-this-app-db-password
# Conexión de administración (dueña de las tablas): sync/DDL/migraciones y scripts de
# mantenimiento (seed.js, createPlatformAdmin.js) — nunca para atender peticiones HTTP.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/gestionproyectos
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=8h
UPLOAD_DIR=uploads
CORS_ORIGIN=http://localhost:5173
# Integración WhatsApp (módulo Inventario) — cuenta de LoroAPI
LOROAPI_BASE_URL=https://loroapi.com/api/v1
LOROAPI_API_KEY=
# Confirmación de recepción/devolución por enlace público (Inventario)
FRONTEND_PUBLIC_URL=http://localhost:5173
INVENTORY_CONFIRMATION_HOURS=48
# Lectura automática de documentos con IA (RUT, facturas, contratos, pólizas) — API de Claude
# (Anthropic). Nunca se expone al frontend: solo se usa en el backend. Si se deja vacía, RUT y
# facturas siguen funcionando con el motor local (OCR); contratos y pólizas requieren esta clave.
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5-20250929
# Cuenta inicial de operador de la plataforma (panel de super-admin) — solo se usan una vez, al
# correr `node src/scripts/createPlatformAdmin.js` a mano; no hace falta dejarlas puestas después.
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
